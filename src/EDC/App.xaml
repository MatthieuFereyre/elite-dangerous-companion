<Application x:Class="EDC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:EDC.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <views:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <views:BoolToHiddenConverter x:Key="BoolToHidden" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
