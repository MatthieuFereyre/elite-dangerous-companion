<ui:FluentWindow x:Class="EDC.Views.ReplayWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:res="clr-namespace:EDC.Resources"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{x:Static res:Strings.ReplayTitle}"
                 Width="620" Height="460"
                 MinWidth="420" MinHeight="260"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="{DynamicResource ApplicationBackgroundBrush}">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="{x:Static res:Strings.ReplayTitle}" ShowMaximize="False" />

        <TextBlock x:Name="Caption"
                   DockPanel.Dock="Top"
                   Margin="20,4,20,10"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBox x:Name="Output"
                 Margin="20,0,20,20"
                 IsReadOnly="True"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="13"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</ui:FluentWindow>
